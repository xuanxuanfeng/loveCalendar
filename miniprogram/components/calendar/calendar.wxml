<!-- components/calendar/calendar.wxml -->
<view class="calendar-container">
  <!-- 月份导航 -->
  <view class="calendar-header">
    <view class="month-nav" bindtap="onPrevMonth">
      <text class="nav-arrow">‹</text>
    </view>
    <view class="month-year">
      <text class="year">{{currentYear}}年</text>
      <text class="month">{{currentMonth}}</text>
    </view>
    <view class="month-nav" bindtap="onNextMonth">
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <!-- 星期标题 -->
  <view class="weekdays">
    <text class="weekday">日</text>
    <text class="weekday">一</text>
    <text class="weekday">二</text>
    <text class="weekday">三</text>
    <text class="weekday">四</text>
    <text class="weekday">五</text>
    <text class="weekday">六</text>
  </view>

  <!-- 日期网格 -->
  <view class="calendar-grid">
    <block wx:for="{{calendarDays}}" wx:key="date">
      <view
        class="calendar-day {{item.isCurrentMonth ? 'current-month' : 'other-month'}} {{item.isToday ? 'today' : ''}}"
        data-date="{{item.date}}"
        bindtap="onDayTap"
      >
        <view class="day-content">
          <!-- 记录标记 -->
          <view wx:if="{{item.hasRecord}}" class="record-marker"></view>

          <!-- 纪念日标记 -->
          <view wx:if="{{item.isAnniversary}}" class="anniversary-marker"></view>

          <text class="day-number {{item.hasRecord ? 'has-record' : ''}} {{item.isAnniversary ? 'is-anniversary' : ''}} {{item.isToday ? 'today-highlight' : ''}}">
            {{item.day}}
          </text>
        </view>
      </view>
    </block>
  </view>
</view>