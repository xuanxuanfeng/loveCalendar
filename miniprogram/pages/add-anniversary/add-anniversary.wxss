/* pages/add-anniversary/add-anniversary.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 20px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 15px 20px;
  background: white;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 20px;
  background: #f8f9fa;
  cursor: pointer;
}

.back-icon {
  font-size: 18px;
  color: #5D8CAE;
  margin-right: 4px;
}

.back-text {
  font-size: 14px;
  color: #5D8CAE;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #5D8CAE;
  font-family: "思源黑体", "苹方", "冬青黑体", sans-serif;
}

.placeholder {
  width: 60px;
}

.input-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.input-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
}

.input-field {
  width: 90%;
  padding: 12px 16px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  font-size: 16px;
  background: #fafafa;
}

.date-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.date-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  background: #fafafa;
}

.selected-date {
  font-size: 16px;
  color: #333;
}

.picker-icon {
  color: #888;
  font-size: 12px;
}

.countdown-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.switch-label {
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.switch-desc {
  display: block;
  font-size: 12px;
  color: #999;
  line-height: 1.5;
}

.countdown-days-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.countdown-days-header {
  margin-bottom: 12px;
}

.input-desc {
  display: block;
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

/* 标签样式 */
.countdown-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.tag {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  border-radius: 16px;
  color: white;
  font-size: 14px;
}

.tag-text {
  margin-right: 6px;
}

.tag-remove {
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  opacity: 0.8;
  padding: 0 2px;
}

.tag-remove:hover {
  opacity: 1;
}

.countdown-input-row {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.countdown-input {
  flex: 1;
  width: auto;
}

.add-tag-btn {
  width: 80px;
  height: 44px;
  padding: 0;
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  font-size: 14px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 快捷标签 */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.quick-label {
  font-size: 12px;
  color: #999;
}

.quick-tag {
  padding: 4px 12px;
  background: #f5f5f5;
  border-radius: 12px;
  font-size: 12px;
  color: #5D8CAE;
  border: 1px solid #e0e0e0;
}

.action-section {
  padding: 30px 20px 20px 20px;
  margin: 10px 15px;
}

.save-btn {
  width: 100%;
  height: 50px;
  padding: 17px;
  border-radius: 25px;
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  font-size: 16px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.save-btn:not([disabled]):hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(133, 193, 220, 0.4);
}

.save-btn[disabled] {
  opacity: 0.6;
  cursor: not-allowed;
}
