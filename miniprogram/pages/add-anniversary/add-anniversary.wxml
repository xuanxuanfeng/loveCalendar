<!-- pages/add-anniversary/add-anniversary.wxml -->
<view class="container">
  <!-- 页面头部 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <text class="title">{{isEditing ? '编辑纪念日' : '设为纪念日'}}</text>
    <view class="placeholder"></view>
  </view>

  <!-- 纪念日名称 -->
  <view class="input-section">
    <text class="input-label">纪念日名称</text>
    <input
      class="input-field"
      placeholder="例如：恋爱纪念日、结婚纪念日"
      value="{{name}}"
      bindinput="onNameInput"
    />
  </view>

  <!-- 日期选择 -->
  <view class="date-section">
    <text class="date-label">选择日期</text>
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="date-picker">
        <text class="selected-date">{{selectedDate}}</text>
        <text class="picker-icon">▼</text>
      </view>
    </picker>
  </view>

  <!-- 倒数日模式开关 -->
  <view class="countdown-section">
    <view class="switch-row">
      <text class="switch-label">启用倒数日模式</text>
      <switch
        class="countdown-switch"
        checked="{{isCountdownMode}}"
        bindchange="onCountdownModeChange"
        color="#5D8CAE"
      />
    </view>
    <text class="switch-desc">开启后可自定义多个倒数日（如 100 天、365 天、520 天）</text>
  </view>

  <!-- 倒数日天数输入（仅在倒数日模式下显示） -->
  <view class="countdown-days-section" wx:if="{{isCountdownMode}}">
    <view class="countdown-days-header">
      <text class="input-label">倒数日天数</text>
      <text class="input-desc">可添加多个，如 100、365、520 等</text>
    </view>
    
    <!-- 已添加的倒数日标签 -->
    <view class="countdown-tags" wx:if="{{countdownDaysList.length > 0}}">
      <view class="tag" wx:for="{{countdownDaysList}}" wx:key="*this">
        <text class="tag-text">{{item}}</text>
        <text class="tag-remove" bindtap="removeCountdownDay" data-index="{{index}}" data-countdown="{{item}}">×</text>
      </view>
    </view>
    
    <!-- 输入框和添加按钮 -->
    <view class="countdown-input-row">
      <input
        class="input-field countdown-input"
        type="number"
        placeholder="输入天数"
        value="{{countdownDaysInput}}"
        bindinput="onCountdownDaysInput"
      />
      <button class="add-tag-btn" bindtap="addCountdownDay">添加</button>
    </view>
    
    <!-- 快捷选项 -->
    <view class="quick-tags">
      <text class="quick-label">快捷添加:</text>
      <view class="quick-tag" bindtap="addQuickCountdownDay" data-days="100">100 天</view>
      <view class="quick-tag" bindtap="addQuickCountdownDay" data-days="365">365 天</view>
      <view class="quick-tag" bindtap="addQuickCountdownDay" data-days="520">520 天</view>
      <view class="quick-tag" bindtap="addQuickCountdownDay" data-days="1000">1000 天</view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="action-section">
    <button class="save-btn" bindtap="saveAnniversary" disabled="{{isSaving}}">
      {{isSaving ? '保存中...' : (isEditing ? '更新纪念日' : '添加纪念日')}}
    </button>
  </view>
</view>
