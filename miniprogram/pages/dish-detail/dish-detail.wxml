<!-- pages/dish-detail/dish-detail.wxml -->
<view class="container">
  <view wx:if="{{!dish}}" class="loading">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- 菜品图片 -->
    <view class="dish-hero">
      <image wx:if="{{dish.imageUrl}}" src="{{dish.imageUrl}}" class="hero-img" mode="aspectFill" />
      <view wx:else class="hero-placeholder">
        <text class="hero-emoji">🍴</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="dish-info">
      <view class="info-header">
        <text class="dish-name">{{dish.name}}</text>
        <view class="dish-badges">
          <text class="badge category">{{dish.category}}</text>
          <text class="badge difficulty">{{difficultyLabel}}</text>
        </view>
      </view>

      <view wx:if="{{dish.description}}" class="dish-desc">
        <text>{{dish.description}}</text>
      </view>

      <view class="dish-stats">
        <view class="stat-item">
          <text class="stat-value">{{dish.likeCount}}</text>
          <text class="stat-label">被选次数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{dish.estimatedTime || '-'}}</text>
          <text class="stat-label">预计分钟</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{dish.authorNickname || '匿名'}}</text>
          <text class="stat-label">创建者</text>
        </view>
      </view>

      <!-- 标签 -->
      <view wx:if="{{dish.tags && dish.tags.length > 0}}" class="dish-tags">
        <text class="tag" wx:for="{{dish.tags}}" wx:key="*this">{{item}}</text>
      </view>

      <!-- 食材 -->
      <view wx:if="{{dish.ingredients}}" class="dish-section">
        <text class="section-title">食材</text>
        <text class="section-content">{{dish.ingredients}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view wx:if="{{isOwner}}" class="action-buttons">
      <button class="edit-btn" bindtap="editDish">
        <text>编辑</text>
      </button>
      <button class="delete-btn" bindtap="deleteDish">
        <text>下架</text>
      </button>
    </view>
  </block>
</view>
