/* pages/dish-detail/dish-detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 30px;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 60px 0;
  color: #999;
}

.dish-hero {
  width: 100%;
  height: 240px;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.hero-emoji {
  font-size: 60px;
}

.dish-info {
  background: white;
  margin: -20px 15px 15px;
  border-radius: 12px;
  padding: 20px;
  position: relative;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.info-header {
  margin-bottom: 12px;
}

.dish-name {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #333;
  margin-bottom: 8px;
}

.dish-badges {
  display: flex;
  gap: 8px;
}

.badge {
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 10px;
  color: white;
}

.badge.category {
  background: #85C1DC;
}

.badge.difficulty {
  background: #FFB347;
}

.dish-desc {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16px;
}

.dish-stats {
  display: flex;
  justify-content: space-around;
  padding: 16px 0;
  border-top: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 16px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 18px;
  font-weight: 600;
  color: #5D8CAE;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 16px;
}

.tag {
  font-size: 12px;
  color: #666;
  background: #f5f5f5;
  padding: 3px 10px;
  border-radius: 12px;
}

.dish-section {
  margin-bottom: 12px;
}

.section-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 6px;
}

.section-content {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 12px;
  padding: 0 15px;
}

.edit-btn, .delete-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  color: white;
  font-size: 15px;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
}

.delete-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
}
