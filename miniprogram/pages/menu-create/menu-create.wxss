/* pages/menu-create/menu-create.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding: 15px;
  padding-bottom: 40px;
}

.form-section {
  background: white;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.label-row .label {
  margin-bottom: 0;
}

.label-action {
  font-size: 13px;
  color: #85C1DC;
}

.picker-value {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  color: #333;
}

.meal-grid {
  display: flex;
  gap: 8px;
}

.meal-option {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  border-radius: 8px;
  font-size: 13px;
  color: #666;
  background: #f5f5f5;
}

.meal-option.active {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
}

.empty-candidates {
  text-align: center;
  padding: 20px;
  font-size: 13px;
  color: #999;
}

.candidates-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.candidate-item {
  display: flex;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  background: #f8f9fa;
}

.candidate-img, .candidate-img-placeholder {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  margin-right: 8px;
  object-fit: cover;
}

.candidate-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
  font-size: 16px;
}

.candidate-name {
  flex: 1;
  font-size: 14px;
  color: #333;
}

.candidate-remove {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  background: #ff6b6b;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.submit-btn {
  margin-top: 20px;
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  border: none;
  border-radius: 22px;
  height: 44px;
  font-size: 16px;
  font-weight: 600;
}

.submit-btn[disabled] {
  background: #ccc;
}
