/* pages/dish-list/dish-list.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 20px;
}

.category-bar {
  white-space: nowrap;
  padding: 12px 15px;
  background: white;
}

.category-tag {
  display: inline-block;
  padding: 6px 16px;
  border-radius: 16px;
  font-size: 13px;
  color: #666;
  background: #f5f5f5;
  margin-right: 8px;
}

.category-tag.active {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
}

.search-bar {
  padding: 10px 15px;
  background: white;
  border-bottom: 1px solid #f0f0f0;
}

.search-input {
  background: #f5f5f5;
  border-radius: 20px;
  padding: 8px 16px;
  font-size: 14px;
}

.loading, .empty {
  display: flex;
  justify-content: center;
  padding: 60px 0;
  color: #999;
  font-size: 14px;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 15px;
}

.dish-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.dish-card-img, .dish-card-img-placeholder {
  width: 100%;
  height: 120px;
  object-fit: cover;
}

.dish-card-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  font-size: 36px;
}

.dish-card-info {
  padding: 10px;
}

.dish-card-name {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.dish-card-category {
  font-size: 12px;
  color: #85C1DC;
  background: #E8F4FD;
  padding: 1px 6px;
  border-radius: 4px;
}

.dish-card-likes {
  font-size: 12px;
  color: #FFB347;
}

.dish-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.tag {
  font-size: 11px;
  color: #999;
  background: #f5f5f5;
  padding: 1px 6px;
  border-radius: 4px;
}

.load-more {
  text-align: center;
  padding: 16px;
  font-size: 14px;
  color: #85C1DC;
}

/* 选择模式 */
.pick-mode {
  padding-bottom: 70px;
}

.dish-card.selected {
  border: 2px solid #85C1DC;
  box-shadow: 0 2px 12px rgba(133, 193, 220, 0.3);
}

.dish-check {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.85);
  border: 2px solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: white;
  z-index: 1;
}

.dish-check.checked {
  background: #85C1DC;
  border-color: #85C1DC;
}

.dish-card {
  position: relative;
}

.pick-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  background: white;
  border-top: 1px solid #f0f0f0;
  z-index: 100;
}

.pick-count {
  font-size: 14px;
  color: #666;
}

.pick-confirm-btn {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  border: none;
  border-radius: 20px;
  padding: 0 24px;
  height: 36px;
  font-size: 14px;
  font-weight: 600;
  line-height: 36px;
}

.pick-confirm-btn[disabled] {
  background: #ccc;
}
