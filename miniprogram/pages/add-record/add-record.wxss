/* pages/add-record/add-record.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding: 0;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 15px 20px;
  background: white;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 20px;
  background: #f8f9fa;
  cursor: pointer;
}

.back-icon {
  font-size: 18px;
  color: #5D8CAE;
  margin-right: 4px;
}

.back-text {
  font-size: 14px;
  color: #5D8CAE;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #5D8CAE;
  font-family: "思源黑体", "苹方", "冬青黑体", sans-serif;
}

.placeholder {
  width: 60px;
}

.date-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.date-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  background: #fafafa;
}

.selected-date {
  font-size: 16px;
  color: #333;
}

.picker-icon {
  color: #888;
  font-size: 12px;
}

.content-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.content-input {
  width: 100%;
  min-height: 120px;
  font-size: 16px;
  line-height: 1.5;
  border: none;
  outline: none;
  resize: none;
  background: transparent;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 12px;
  color: #999;
  margin-top: 8px;
}

.image-section {
  padding: 20px;
  background: white;
  margin: 10px 15px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.image-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 15px;
}

.image-upload-area {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100px;
  height: 100px;
  border: 2px dashed #e0e0e0;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.upload-btn:hover {
  border-color: #85C1DC;
  background: rgba(133, 193, 220, 0.05);
}

.upload-icon {
  font-size: 24px;
  color: #85C1DC;
  margin-bottom: 5px;
}

.upload-text {
  font-size: 12px;
  color: #85C1DC;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 10px;
  margin-top: 10px;
}

.image-item {
  position: relative;
  width: 80px;
  height: 80px;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.uploaded-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.remove-btn {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #ff4757;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
}

.remove-icon {
  font-size: 12px;
  color: white;
  line-height: 1;
}

.action-section {
  padding: 30px 20px 20px 20px;
  margin: 10px 15px;
}

.save-btn {
  width: 100%;
  height: 50px;
  border-radius: 25px;
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  font-size: 16px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.save-btn:not([disabled]):hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(133, 193, 220, 0.4);
}

.save-btn[disabled] {
  opacity: 0.6;
  cursor: not-allowed;
}

/* 响应式设计 */
@media (max-width: 750px) {
  .container {
    padding-bottom: 20px;
  }

  .image-grid {
    grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
  }

  .image-item {
    width: 70px;
    height: 70px;
  }
}
