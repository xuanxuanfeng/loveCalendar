/* pages/kitchen/kitchen.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 30px;
}

.section {
  background: white;
  margin: 15px;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.title-icon {
  font-size: 20px;
  margin-right: 6px;
}

.title-text {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.section-more {
  font-size: 13px;
  color: #85C1DC;
}

.menu-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 10px;
  color: white;
}

.status-voting {
  background: #FFB347;
}

.status-decided {
  background: #66BB6A;
}

.status-cancelled {
  background: #999;
}

/* 候选菜品列表 */
.candidates-list {
  margin-bottom: 12px;
}

.candidate-item {
  display: flex;
  align-items: center;
  padding: 10px;
  border-radius: 8px;
  margin-bottom: 8px;
  background: #f8f9fa;
  transition: all 0.2s;
}

.candidate-item.selected {
  background: #E8F4FD;
  border: 1px solid #85C1DC;
}

.candidate-img, .candidate-img-placeholder {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  margin-right: 10px;
  object-fit: cover;
}

.candidate-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
  font-size: 18px;
}

.candidate-name {
  flex: 1;
  font-size: 15px;
  color: #333;
}

.candidate-check {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  border: 2px solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: white;
}

.candidate-check.checked {
  background: #85C1DC;
  border-color: #85C1DC;
}

/* 投票操作 */
.vote-actions {
  margin-top: 12px;
}

.my-vote-info {
  font-size: 13px;
  color: #5D8CAE;
  margin-bottom: 8px;
}

.vote-btn {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  border: none;
  border-radius: 20px;
  height: 40px;
  font-size: 15px;
  font-weight: 600;
}

.vote-btn[disabled] {
  background: #ccc;
}

.decided-info {
  padding: 10px;
  background: #E8F8E8;
  border-radius: 8px;
}

.decided-text {
  font-size: 15px;
  color: #4CAF50;
  font-weight: 500;
}

.no-menu {
  text-align: center;
  padding: 20px 0;
}

.no-menu-text {
  display: block;
  font-size: 14px;
  color: #999;
  margin-bottom: 12px;
}

.create-menu-btn {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  border: none;
  border-radius: 20px;
  height: 36px;
  font-size: 14px;
}

/* 快捷操作 */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 0;
  border-radius: 8px;
  background: #f8f9fa;
}

.action-icon {
  font-size: 24px;
  margin-bottom: 4px;
}

.action-label {
  font-size: 12px;
  color: #666;
}

/* 我的菜品 */
.empty-dishes {
  text-align: center;
  padding: 20px;
  font-size: 13px;
  color: #999;
}

.dish-preview-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dish-preview-item {
  display: flex;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  background: #f8f9fa;
}

.dish-preview-img, .dish-preview-img-placeholder {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  margin-right: 10px;
  object-fit: cover;
}

.dish-preview-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
  font-size: 20px;
}

.dish-preview-info {
  flex: 1;
}

.dish-preview-name {
  display: block;
  font-size: 15px;
  color: #333;
  font-weight: 500;
}

.dish-preview-likes {
  font-size: 12px;
  color: #FFB347;
}

/* 历史记录 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 4px;
  border-bottom: 1px solid #f5f5f5;
}

.history-date {
  font-size: 13px;
  color: #999;
}

.history-dish {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}
