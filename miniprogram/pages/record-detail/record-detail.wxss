/* pages/record-detail/record-detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 20px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 15px 20px;
  background: white;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 20px;
  background: #f8f9fa;
  cursor: pointer;
}

.back-icon {
  font-size: 18px;
  color: #5D8CAE;
  margin-right: 4px;
}

.back-text {
  font-size: 14px;
  color: #5D8CAE;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #5D8CAE;
  font-family: "思源黑体", "苹方", "冬青黑体", sans-serif;
}

.placeholder {
  width: 60px;
}

.record-detail {
  background: white;
  margin: 15px;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.record-date {
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.date-text {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #5D8CAE;
  margin-bottom: 5px;
}

.time-text {
  font-size: 14px;
  color: #85C1DC;
}

.record-content {
  margin-bottom: 20px;
}

.content-text {
  font-size: 16px;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.record-images {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 10px;
  margin-top: 15px;
}

.detail-image {
  width: 100%;
  height: 100px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  object-fit: cover;
}

.detail-image:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.action-buttons {
  display: flex;
  gap: 15px;
  padding: 0 15px;
}

.edit-btn, .delete-btn {
  flex: 1;
  height: 50px;
  border-radius: 25px;
  color: white;
  font-size: 16px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.edit-btn {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
}

.edit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(133, 193, 220, 0.4);
}

.delete-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
}

.delete-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(255, 107, 107, 0.4);
}

.btn-icon {
  margin-right: 8px;
  font-size: 18px;
}

.btn-text {
  font-size: 16px;
  font-weight: 600;
}

/* 响应式设计 */
@media (max-width: 750px) {
  .record-images {
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  }
  
  .detail-image {
    height: 80px;
  }
}