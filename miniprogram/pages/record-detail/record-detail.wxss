/* pages/record-detail/record-detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 20px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 15px 20px;
  background: white;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 20px;
  background: #f8f9fa;
}

.back-icon {
  font-size: 18px;
  color: #5D8CAE;
  margin-right: 4px;
}

.back-text {
  font-size: 14px;
  color: #5D8CAE;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #5D8CAE;
}

.placeholder {
  width: 60px;
}

.record-detail {
  background: white;
  margin: 15px;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.record-date {
  margin-bottom: 15px;
  padding-bottom: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.date-text {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #5D8CAE;
  margin-bottom: 5px;
}

.time-text {
  font-size: 14px;
  color: #85C1DC;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
  padding-bottom: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.author-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  margin-right: 10px;
  flex-shrink: 0;
}

.default-avatar {
  background: linear-gradient(135deg, #85C1DC, #5D8CAE);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 16px;
  font-weight: 600;
}

.author-meta {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.edit-info {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.record-content {
  margin-bottom: 20px;
}

.content-text {
  font-size: 16px;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.record-images {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 10px;
  margin-top: 15px;
}

.detail-image {
  width: 100%;
  height: 100px;
  border-radius: 8px;
  object-fit: cover;
}

.last-edited {
  margin-top: 15px;
  padding-top: 12px;
  border-top: 1px solid #f0f0f0;
}

.last-edited-text {
  font-size: 12px;
  color: #999;
}

/* 通用区块 */
.section {
  background: white;
  margin: 0 15px 15px 15px;
  border-radius: 12px;
  padding: 16px 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #5D8CAE;
}

.section-arrow {
  font-size: 20px;
  color: #ccc;
}

/* 评论区域 */
.comments-section {
  flex-direction: column;
  align-items: stretch;
}

.comments-section .section-title {
  margin-bottom: 12px;
}

.comments-list {
  margin-bottom: 12px;
}

.comment-item {
  display: flex;
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar-wrap {
  margin-right: 10px;
  flex-shrink: 0;
}

.comment-avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
}

.default-comment-avatar {
  background: linear-gradient(135deg, #85C1DC, #5D8CAE);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text-sm {
  color: white;
  font-size: 13px;
  font-weight: 600;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 4px;
}

.comment-author {
  font-size: 13px;
  font-weight: 600;
  color: #5D8CAE;
  margin-right: 8px;
}

.comment-time {
  font-size: 11px;
  color: #bbb;
}

.comment-delete {
  font-size: 11px;
  color: #e88;
  margin-left: auto;
  padding: 2px 6px;
}

.comment-content {
  font-size: 14px;
  color: #333;
  line-height: 1.5;
}

.no-comments {
  padding: 20px 0;
  text-align: center;
}

.no-comments-text {
  font-size: 14px;
  color: #ccc;
}

.comment-input-area {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
}

.comment-input {
  flex: 1;
  height: 36px;
  background: #f5f5f5;
  border-radius: 18px;
  padding: 0 16px;
  font-size: 14px;
}

.send-btn {
  height: 36px;
  line-height: 36px;
  padding: 0 16px;
  font-size: 13px;
  background: linear-gradient(135deg, #85C1DC, #5D8CAE);
  color: white;
  border-radius: 18px;
  border: none;
}

.send-btn[disabled] {
  opacity: 0.5;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15px;
  padding: 0 15px;
}

.edit-btn, .delete-btn {
  flex: 1;
  height: 50px;
  border-radius: 25px;
  color: white;
  font-size: 16px;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
}

.delete-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
}

.btn-icon {
  margin-right: 8px;
  font-size: 18px;
}

.btn-text {
  font-size: 16px;
  font-weight: 600;
}

@media (max-width: 750px) {
  .record-images {
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  }

  .detail-image {
    height: 80px;
  }
}
