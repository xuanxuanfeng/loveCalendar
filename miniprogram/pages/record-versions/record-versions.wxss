/* pages/record-versions/record-versions.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 20px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 15px 20px;
  background: white;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 20px;
  background: #f8f9fa;
}

.back-icon {
  font-size: 18px;
  color: #5D8CAE;
  margin-right: 4px;
}

.back-text {
  font-size: 14px;
  color: #5D8CAE;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #5D8CAE;
}

.placeholder {
  width: 60px;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 60px 0;
  color: #999;
  font-size: 14px;
}

.empty {
  display: flex;
  justify-content: center;
  padding: 60px 0;
}

.empty-text {
  color: #999;
  font-size: 14px;
}

.version-list {
  padding: 15px;
}

.version-item {
  background: white;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.version-header {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.version-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 10px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
  color: white;
  margin-right: 10px;
}

.badge-create {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
}

.badge-edit {
  background: linear-gradient(135deg, #FFB347 0%, #FF8C42 100%);
}

.version-type {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.version-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.meta-author {
  font-size: 13px;
  color: #5D8CAE;
  margin-right: 12px;
}

.meta-time {
  font-size: 13px;
  color: #999;
}

.version-note {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 13px;
  color: #666;
  line-height: 1.6;
}

.version-hint {
  margin-top: 8px;
  text-align: right;
  font-size: 12px;
  color: #bbb;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.version-detail {
  background: white;
  border-radius: 16px;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 20px;
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.detail-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 10px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
  color: white;
  margin-right: 10px;
}

.detail-title {
  flex: 1;
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.detail-close {
  font-size: 20px;
  color: #999;
  padding: 4px 8px;
}

.detail-content {
  margin-bottom: 16px;
}

.detail-text {
  font-size: 15px;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.detail-image {
  width: calc(33.33% - 6px);
  height: 100px;
  border-radius: 8px;
  background: #f5f5f5;
}

.detail-note {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 13px;
  color: #666;
  line-height: 1.6;
}

.note-label {
  font-weight: 500;
  color: #999;
}
