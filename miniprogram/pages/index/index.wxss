/* pages/index/index.wxss */
.offline-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #FFF3CD;
  color: #856404;
  font-size: 24rpx;
  text-align: center;
}

.offline-icon {
  font-size: 28rpx;
}

.offline-text {
  font-size: 24rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding-bottom: 20px;
  position: relative;
}

.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.1) 0%, transparent 50%),
                    radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.1) 0%, transparent 50%);
  pointer-events: none;
  z-index: -1;
}

.header {
  text-align: center;
  padding: 40px 20px 20px 20px;
  position: relative;
}

.title {
  display: block;
  font-size: 28px;
  font-weight: bold;
  color: #5D8CAE;
  margin-bottom: 8px;
  font-family: "思源黑体", "苹方", "冬青黑体", sans-serif;
}

.subtitle {
  display: block;
  font-size: 16px;
  color: #85C1DC;
  opacity: 0.8;
}

.quick-actions {
  display: flex;
  gap: 16px;
  padding: 0 20px 20px 20px;
  justify-content: center;
}

.couple-status {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F9FA 100%);
  border-radius: 16px;
  padding: 16px 20px;
  margin: 0 20px 20px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8px 24px rgba(133, 193, 220, 0.2);
  transition: all 0.3s ease;
  cursor: pointer;
  border: 2px solid rgba(133, 193, 220, 0.1);
}

.couple-status:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(133, 193, 220, 0.3);
}

.couple-status.couple-status-unbind {
  background: linear-gradient(135deg, #FFECEC 0%, #FFE0E0 100%);
}

.couple-icon {
  margin-right: 12px;
}

.icon {
  font-size: 24px;
}

.couple-text {
  flex: 1;
}

.couple-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #5D8CAE;
  margin-bottom: 4px;
}

.couple-desc {
  display: block;
  font-size: 12px;
  color: #85C1DC;
  opacity: 0.7;
}

.couple-arrow {
  color: #85C1DC;
  font-size: 18px;
  font-weight: bold;
}

.action-card {
  flex: 1;
  min-width: 140px;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F9FA 100%);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(133, 193, 220, 0.2);
  transition: all 0.3s ease;
  cursor: pointer;
  border: 2px solid rgba(133, 193, 220, 0.1);
}

.action-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(133, 193, 220, 0.3);
}

.action-icon {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: linear-gradient(135deg, #85C1DC 0%, #F1C27D 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.icon {
  font-size: 24px;
}

.action-text {
  text-align: center;
}

.action-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #5D8CAE;
  margin-bottom: 4px;
}

.action-desc {
  display: block;
  font-size: 12px;
  color: #85C1DC;
  opacity: 0.7;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 20px;
  margin-top: 20px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.legend-color {
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

.legend-color.record {
  background: #F1C27D;
}

.legend-color.anniversary {
  background: #dc8591;
}

.legend-color.today {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
}

.legend-text {
  font-size: 12px;
  color: #5D8CAE;
  opacity: 0.8;
}

/* 最近纪念日区域样式 */
.recent-anniversaries-section {
  background: white;
  margin: 15px 20px;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #f0f0f0;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #5D8CAE;
}

.view-all {
  font-size: 12px;
  color: #85C1DC;
  cursor: pointer;
}

.anniversary-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.anniversary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f8f9fa;
}

.anniversary-item:last-child {
  border-bottom: none;
}

.anniversary-info {
  flex: 1;
}

.anniversary-name {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.anniversary-date {
  font-size: 12px;
  color: #85C1DC;
}

.anniversary-countdown {
  text-align: right;
}

.countdown-text {
  font-size: 12px;
  color: #F1C27D;
  font-weight: 500;
}

/* 响应式设计 */
@media (max-width: 750px) {
  .quick-actions {
    flex-direction: column;
    align-items: center;
  }

  .action-card {
    width: 90%;
    max-width: 300px;
  }

  .title {
    font-size: 24px;
  }
}