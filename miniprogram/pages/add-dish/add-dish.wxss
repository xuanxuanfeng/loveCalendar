/* pages/add-dish/add-dish.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFECEC 50%, #FFE0E0 100%);
  padding: 15px;
  padding-bottom: 40px;
}

.form-section {
  background: white;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.form-row {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.form-section.half {
  flex: 1;
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
}

.input {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  width: 100%;
  box-sizing: border-box;
}

.textarea {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  width: 100%;
  height: 80px;
  box-sizing: border-box;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.category-option {
  padding: 6px 16px;
  border-radius: 16px;
  font-size: 13px;
  color: #666;
  background: #f5f5f5;
}

.category-option.active {
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
}

.picker-value {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  color: #333;
}

.time-input-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
}

.time-input {
  flex: 1;
}

.time-unit {
  font-size: 13px;
  color: #999;
  white-space: nowrap;
}

.tags-input-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}

.tag-item {
  display: flex;
  align-items: center;
  background: #E8F4FD;
  border-radius: 12px;
  padding: 4px 10px;
  font-size: 13px;
  color: #5D8CAE;
}

.tag-remove {
  margin-left: 4px;
  font-size: 14px;
  color: #999;
}

.tag-input {
  flex: 1;
  min-width: 120px;
  background: #f8f9fa;
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 13px;
}

.image-picker {
  display: flex;
}

.preview-wrap {
  position: relative;
}

.preview-img {
  width: 120px;
  height: 120px;
  border-radius: 8px;
  object-fit: cover;
}

.remove-img {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 22px;
  height: 22px;
  background: #ff6b6b;
  color: white;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.pick-btn {
  width: 120px;
  height: 120px;
  border: 2px dashed #ddd;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pick-icon {
  font-size: 30px;
  color: #ccc;
  line-height: 1;
}

.pick-text {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.submit-btn {
  margin-top: 20px;
  background: linear-gradient(135deg, #85C1DC 0%, #5D8CAE 100%);
  color: white;
  border: none;
  border-radius: 22px;
  height: 44px;
  font-size: 16px;
  font-weight: 600;
}

.submit-btn[disabled] {
  background: #ccc;
}
