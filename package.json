{
  "name": "love-calendar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "eslint cloudfunctions/ miniprogram/ --ext .js --quiet"
  },
  "jest": {
    "projects": [
      {
        "displayName": "component",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/miniprogram/components/**/*.test.js"
        ]
      },
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/miniprogram/utils/**/*.test.js",
          "<rootDir>/cloudfunctions/__tests__/**/*.test.js"
        ],
        "moduleNameMapper": {
          "^wx-server-sdk$": "<rootDir>/cloudfunctions/__tests__/stubs/wx-server-sdk.js"
        }
      }
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "miniprogram-simulate": "^1.6.2"
  }
}
